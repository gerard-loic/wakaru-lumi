{
    "name": "Wakaru - creation d'une leçon (v2)",
    "services": {
        "wakaru": {
            "login": "******************",
            "password": "******************"
        }
    },
    "trigger": [
        {
            "class": "Api",
            "config": {}
        },
        {
            "class": "Cli",
            "config": {}
        }
    ],
    "blocks": {
        "_root": {
            "class": "Agent",
            "config": {
                "profile": "wakaru-v2",
                "prompt": "",
                "output": "lessontxt"
            },
            "on_success": "savetxt",
            "on_error": "exit(0)"
        },
        "savetxt": {
            "class": "DataViewFile",
            "config": {
                "input": "lessontxt",
                "format": "txt",
                "filename": "lesson_{run.datetime}.txt",
                "output": "lessontxtfile"
            },
            "on_success": "storetxt",
            "on_error": "exit(0)"
        },
        "storetxt": {
            "class": "FileWriter",
            "config": {
                "source": "{lessontxtfile}",
                "destination": "storage/wakaru2/",
                "overwrite": false,
                "output": "lessontxtstored"
            },
            "on_success": "checkformat",
            "on_error": "exit(0)"
        },
        "checkformat": {
            "class": "JsonFormat",
            "config": {
                "input": "lessontxt",
                "format_file": "lesson.schema.json",
                "output": "lessonjson"
            },
            "on_success": "checklesson",
            "on_error": "jsonerror"
        },
        "jsonerror": {
            "class": "PythonScript",
            "config": {
                "script": "jsonerror.py",
                "params": {
                    "input": "lessontxt",
                    "output": "lessonjsonerror"
                }
            },
            "on_success": "fixjson",
            "on_error": "exit(0)"
        },
        "fixjson": {
            "class": "Agent",
            "config": {
                "profile": "wakaru-v2-review",
                "prompt": "Tâche : RÉPARATION\n\nErreur détectée :\n\n{lessonjsonerror}\n\nTexte à réparer :\n\n{lessontxt}",
                "output": "lessontxt"
            },
            "on_success": "checkfixed",
            "on_error": "exit(0)"
        },
        "checkfixed": {
            "class": "JsonFormat",
            "config": {
                "input": "lessontxt",
                "format_file": "lesson.schema.json",
                "output": "lessonjson"
            },
            "on_success": "checklesson",
            "on_error": "exit(0)"
        },
        "checklesson": {
            "class": "PythonScript",
            "config": {
                "script": "checklesson.py",
                "params": {
                    "input": "lessonjson",
                    "input_txt": "lessontxt",
                    "issues": "lessonissues"
                }
            },
            "on_success": "audit",
            "on_error": "audit"
        },
        "audit": {
            "class": "Agent",
            "config": {
                "profile": "wakaru-v2-review",
                "prompt": "Tâche : AUDIT\n\nLeçon à auditer :\n\n{lessontxt}\n\nProblèmes déjà détectés automatiquement (dictionnaire), à reprendre obligatoirement dans ta liste avec leur correction :\n\n{lessonissues}",
                "output": "lessonaudit"
            },
            "on_success": "saveaudit",
            "on_error": "recheck"
        },
        "saveaudit": {
            "class": "DataViewFile",
            "config": {
                "input": "lessonaudit",
                "format": "txt",
                "filename": "lesson_{run.datetime}_audit.txt",
                "output": "lessonauditfile"
            },
            "on_success": "storeaudit",
            "on_error": "hasproblems"
        },
        "storeaudit": {
            "class": "FileWriter",
            "config": {
                "source": "{lessonauditfile}",
                "destination": "storage/wakaru2/",
                "overwrite": false,
                "output": "lessonauditstored"
            },
            "on_success": "hasproblems",
            "on_error": "hasproblems"
        },
        "hasproblems": {
            "class": "Condition",
            "config": {
                "expression": "'AUCUN PROBLÈME' NOT IN lessonaudit OR lessonissues != 'AUCUN'",
                "output": "lessonhasproblems"
            },
            "on_success": "review",
            "on_error": "recheck"
        },
        "review": {
            "class": "Agent",
            "config": {
                "profile": "wakaru-v2-review",
                "prompt": "Tâche : CORRECTION\n\nLeçon à corriger :\n\n{lessontxt}\n\nProblèmes relevés par l'audit :\n\n{lessonaudit}",
                "output": "lessonreviewtxt"
            },
            "on_success": "savereviewtxt",
            "on_error": "recheck"
        },
        "savereviewtxt": {
            "class": "DataViewFile",
            "config": {
                "input": "lessonreviewtxt",
                "format": "txt",
                "filename": "lesson_{run.datetime}_review.txt",
                "output": "lessonreviewtxtfile"
            },
            "on_success": "storereviewtxt",
            "on_error": "checkreview"
        },
        "storereviewtxt": {
            "class": "FileWriter",
            "config": {
                "source": "{lessonreviewtxtfile}",
                "destination": "storage/wakaru2/",
                "overwrite": false,
                "output": "lessonreviewtxtstored"
            },
            "on_success": "checkreview",
            "on_error": "checkreview"
        },
        "checkreview": {
            "class": "JsonFormat",
            "config": {
                "input": "lessonreviewtxt",
                "format_file": "lesson.schema.json",
                "output": "lessonjson"
            },
            "on_success": "recheck",
            "on_error": "recheck"
        },
        "recheck": {
            "class": "PythonScript",
            "config": {
                "script": "checklesson.py",
                "params": {
                    "input": "lessonjson",
                    "input_txt": "lessontxt",
                    "issues": "lessonissues"
                }
            },
            "on_success": "savejson",
            "on_error": "savejson"
        },
        "savejson": {
            "class": "DataViewFile",
            "config": {
                "input": "lessonjson",
                "format": "json",
                "filename": "lesson_{run.datetime}.json",
                "output": "lessonfile"
            },
            "on_success": "storejson",
            "on_error": "exit(0)"
        },
        "storejson": {
            "class": "FileWriter",
            "config": {
                "source": "{lessonfile}",
                "destination": "storage/wakaru2/",
                "overwrite": false,
                "output": "lessonstored"
            },
            "on_success": "sendtowakaru",
            "on_error": "exit(0)"
        },
        "sendtowakaru": {
            "class": "ServiceMethod",
            "config": {
                "service": "wakaru",
                "method": "call",
                "params": {
                    "method": "POST",
                    "endpoint": "llm/createlesson",
                    "input": "lessonjson",
                    "output": "lessoncreated"
                }
            },
            "on_success": "exit(1)",
            "on_error": "exit(0)"
        }
    }
}
