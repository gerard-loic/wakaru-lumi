# Nom du conteneur et du routeur Traefik (unique par projet sur un même serveur)
COMPOSE_PROJECT_NAME=lumi-starter
COMPOSE_PROJECT_HOST=lumi.localhost
# Version exacte de l'image ghcr.io/gerard-loic/lumi (éviter latest)
COMPOSE_LUMI_VERSION=1.6.6
# Prod : always
COMPOSE_RESTART_POLICY=no
# Prod : https
COMPOSE_TRAEFIK_ENTRYPOINT=http
